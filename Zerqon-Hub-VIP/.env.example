# Copy this file to .env for local development. Never commit real secrets.
NODE_ENV=development
PORT=3000

# In production, set this to the exact public origin assigned by your host.
# Example: https://your-real-app-domain.example
PUBLIC_APP_URL=http://localhost:3000

# Optional, but when set it MUST exactly equal PUBLIC_APP_URL + /api/auth/discord/callback.
# Discord Developer Portal -> OAuth2 -> Redirects must contain that exact URI.
# DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback

# Put freshly rotated credentials here locally, or in your host's secret manager.
DISCORD_CLIENT_ID=1559391065130270791
DISCORD_CLIENT_SECRET=replace-with-new-client-secret
DISCORD_BOT_TOKEN=replace-with-new-bot-token
DISCORD_GUILD_ID=1559283861945450536
DISCORD_VIP_ROLE_ID=1560077185170284616
DISCORD_VIP_ROLE_NAME=zerqonviphub
DISCORD_INVITE_URL=https://discord.gg/KP5X63RWeU

# Use a long, random value (at least 32 characters) in production.
SESSION_SECRET=replace-with-a-long-random-session-secret-at-least-32-characters

# Leave true if you want the bot to detect users leaving the Discord server.
ENABLE_DISCORD_GATEWAY=true

# Optional public support destination; blank hides the support link.
SUPPORT_URL=
